# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMIN_IDS=123456789,987654321

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_BACKUP_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
COMMITMENT_LEVEL=confirmed

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/dexbot

# Redis (optional, for future job queue scaling)
REDIS_URL=redis://localhost:6379

# DexScreener
DEXSCREENER_API_URL=https://api.dexscreener.com
DEXSCREENER_PAYMENT_WALLET=YOUR_DEXSCREENER_PAYMENT_WALLET

# Token Launch Defaults
DEFAULT_TOKEN_DECIMALS=9
DEFAULT_INITIAL_SUPPLY=1000000000

# Trading
MAX_SLIPPAGE_BPS=300
PRIORITY_FEE_LAMPORTS=100000
TX_TIMEOUT_MS=60000

# Jupiter API (get key at https://portal.jup.ag)
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=your_jupiter_api_key_here

# Platform Fees (revenue from trades)
TRADING_FEE_BPS=200
DEX_FEE_BPS=400
PLATFORM_FEE_WALLET=YOUR_SOLANA_WALLET_ADDRESS_HERE

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Security
WALLET_ENCRYPTION_KEY=generate_a_strong_32_byte_hex_key_here
