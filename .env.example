# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMIN_IDS=123456789,987654321

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_BACKUP_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
COMMITMENT_LEVEL=confirmed

# Redis (required for job queues and session management at scale)
REDIS_URL=redis://localhost:6379

# DexScreener
DEXSCREENER_API_URL=https://api.dexscreener.com
DEXSCREENER_PAYMENT_WALLET=YOUR_DEXSCREENER_PAYMENT_WALLET

# Token Launch Defaults
DEFAULT_TOKEN_DECIMALS=9
DEFAULT_INITIAL_SUPPLY=1000000000

# Trading
MAX_SLIPPAGE_BPS=300
PRIORITY_FEE_LAMPORTS=100000
TX_TIMEOUT_MS=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Security
WALLET_ENCRYPTION_KEY=generate_a_strong_32_byte_hex_key_here
